# Optional in development; required in production
BGG_API_KEY=

# Required in production; use a send-only key restricted to the configured sending domain
RESEND_API_KEY=

# Set both credentials to make Google authentication available.
# If either is blank, D20 starts normally with Google actions disabled.
# Register an exact callback URL ending in /auth/google/callback before enabling it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Set both credentials to make Discord authentication available.
# If either is blank, D20 starts normally with Discord actions disabled.
# Register an exact callback URL ending in /auth/discord/callback before enabling it.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Meta Developer account: https://developers.facebook.com/apps/
# Set both credentials to make Facebook authentication available.
# If either is blank, D20 starts normally with Facebook actions omitted.
# Add Facebook Login and register the exact callback http://localhost:5000/auth/facebook/callback.
# Development-mode authorization requires an app-role account or Meta test user.
# If Meta rejects local HTTP, use an HTTPS tunnel and register its exact callback instead.
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# Apple Developer account: https://developer.apple.com/account
# APPLE_CLIENT_ID is the Services ID identifier; APPLE_TEAM_ID is in Membership details.
# Create a Sign in with Apple key under Certificates, Identifiers & Profiles -> Keys. Use its
# Key ID for APPLE_KEY_ID and encode the one-time .p8 download as APPLE_PRIVATE_KEY_BASE64.
# Register and set https://<d20-host>/auth/apple/callback as the exact Services ID return URL.
# Set all five values to make Apple authentication available. D20 generates the client-secret JWT.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
APPLE_CALLBACK_URL=
