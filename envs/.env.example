# Optional in development; required in production
BGG_API_KEY=

# Required in production; use a send-only key restricted to the configured sending domain
RESEND_API_KEY=

# Set both credentials to make Google authentication available.
# If either variable is unset, D20 starts normally with Google actions disabled.
# Register an exact callback URL ending in /auth/google/callback before enabling it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
