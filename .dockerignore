# Exclude dependency and build artifacts across the monorepo.
node_modules
**/node_modules

# Nx cache
.nx
.nx/cache

# Elixir build artifacts
**/_build
**/deps
**/cover
**/doc
**/.elixir_ls
**/*.ez
**/erl_crash.dump

# Static artifacts should be built inside Docker images.
**/priv/static/assets
**/priv/static/cache_manifest.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment files
.env*
**/.env*
!.env.example
!**/.env.example

# IDE
.vscode
.idea
**/.vscode
**/.idea

# Tests
coverage
test-output
**/__tests__
**/*.test.*
**/*.spec.ts
**/*.spec.tsx
**/*.spec.js
**/*.spec.jsx
*.tsbuildinfo
**/*.tsbuildinfo

# Temporary / OS
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db
