{
  "private": true,
  "scripts": {
    "browsers": "browserslist",
    "browsers:target": "browserslist-to-esbuild",
    "check": "bun run format.check && bun run lint",
    "format": "eslint . --fix && oxfmt .",
    "format.check": "oxfmt --check .",
    "lint": "eslint .",
    "storybook": "storybook dev --port 6006 --ci",
    "storybook:build": "storybook build --output-dir ../priv/static/storybook",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "test:unit": "vitest run --project unit",
    "test:visual": "vitest run --project 'visual-*'",
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig tsconfig.json",
    "vitest": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource/noto-sans-math": "5.3.0",
    "@inertiajs/svelte": "3.6.0",
    "@rvct/d20sdk": "1.2.0",
    "@sjsf/ajv8-validator": "3.8.0",
    "@sjsf/basic-theme": "3.8.0",
    "@sjsf/form": "3.8.0",
    "@xstate/store": "4.2.1",
    "@xstate/store-svelte": "2.0.0",
    "ajv": "8.20.0",
    "backpex": "file:../deps/backpex",
    "phoenix": "file:../deps/phoenix",
    "phoenix-session": "1.1.0",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "svelte": "^5.55.5",
    "topbar": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/svelte-vite": "^10.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/svelte": "^5.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/ui": "4.1.7",
    "browserslist": "^4.28.6",
    "browserslist-to-esbuild": "^2.1.1",
    "daisyui": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jsdom": "28.1.0",
    "lightningcss": "1.32.0",
    "oxfmt": "^0.54.0",
    "phoenix_vite": "file:../deps/phoenix_vite",
    "playwright": "^1.58.2",
    "storybook": "^10.5.7",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.5",
    "vitest": "4.1.7",
