    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "svelte": "^5.55.5",
    "topbar": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "4.1.7",
    "browserslist": "^4.28.6",
