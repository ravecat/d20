{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".svelte-kit/**",
    ".vite/**",
    ".vitest/**",
    ".vitest-attachments/**",
    "build/**",
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "css/**",
    "vendor/**"
  ],
  "printWidth": 100,
  "svelte": true,
  "tabWidth": 2,
  "useTabs": false
}
